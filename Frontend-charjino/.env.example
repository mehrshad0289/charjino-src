# Local (npm run dev) — copy to .env.local
PORT=3001
BACKEND_URL=http://127.0.0.1:3000/api

# Production is in .env.production
# BACKEND_URL=https://api.charjino.ir/api

# Optional public site/analytics (no secrets). If unset, GA does not load.
# NEXT_PUBLIC_GA_ID=G-W90H63PDCT
# NEXT_PUBLIC_CONTENTSQUARE_TAG_ID=2fdb1ac96e1e9

# Sitemap revalidate and ISR (server-only secret; never commit the value)
# Used by POST /api/revalidate and POST /api/revalidate-sitemap
# REVALIDATE_SECRET=
