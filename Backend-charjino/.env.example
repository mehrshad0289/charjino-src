APP_NAME="چارژینو"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:3000
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=charjino
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@charjino.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

PORT=3000
JWT_ACCESS_SECRET=charjino-dev-access-change-me
JWT_REFRESH_SECRET=charjino-dev-refresh-change-me
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=432000

CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:3002,http://localhost:3002

# توسعه محلی: کد OTP ثابت (صفرها). در production خالی بگذار.
DEV_OTP_CODE=000000

# پیامک الگو — SMS Web Service. کلید را فقط در .env سرور بگذار، نه در گیت.
SMS_API_KEY=
SMS_BASE_URL=https://api.sms-webservice.com/api/V3/
SMS_TEMPLATE_OTP=charjinonet
ADMIN_EMAIL=admin@charjino.local
ADMIN_PASSWORD=charjino-admin
ADMIN_NAME="شارژینو"
ADMIN_FRONT_URL=http://127.0.0.1:3002
SHOP_URL=http://127.0.0.1:3001
STOREFRONT_URL=http://127.0.0.1:3001
STOREFRONT_REVALIDATE_SECRET=

# Shop2TopUp — هرگز در فرانت یا گیت نگذار
S2T_BASE=https://shop2topup.com/api/endpoints/v1
S2T_KEY=
S2T_WEBHOOK_SECRET=
ALLOW_LIVE_ORDER=no

# درگاه. مقدار: mock | zibal | zarinpal
PAYMENT_DRIVER=zarinpal
PAYMENT_CALLBACK_URL=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZARINPAL_BASE_URL=https://payment.zarinpal.com/pg/v4/payment/
ZARINPAL_START_PAY_URL=https://payment.zarinpal.com/pg/StartPay/

# درگاه زیبال (پشتیبان). لوکال: merchant تستی zibal. تولید: کد مرچنت پنل.
ZIBAL_MERCHANT=
ZIBAL_CALLBACK_URL=
ZIBAL_BASE_URL=https://gateway.zibal.ir/v1/
ZIBAL_START_PAY_URL=https://gateway.zibal.ir/start/
ZIBAL_TEST_MODE=false

# FazerCards — هرگز در فرانت یا گیت نگذار. پنل ادمین هم می‌تواند کلید را رمزشده در settings ذخیره کند.
FAZERCARDS_API_BASE=https://api.fzr.cards/api/v2
FAZERCARDS_API_KEY=
FAZERCARDS_ALLOW_LIVE_ORDER=false
FAZERCARDS_BLOCK_PAY_ON_LOW_BALANCE=false
FAZERCARDS_WEBHOOK_SECRET=
FAZERCARDS_STEAM_GIFTS_SHOP_MAX=50000
FAZERCARDS_LISTED_SHOP_MAX=800
FAZERCARDS_GAMEKEYS_PER_PLATFORM=300
FAZERCARDS_HOME_PER_GROUP=12

# CODM Activision region check (Codashop validate). Off by default. Never logs UID/nickname.
CODM_REGION_CHECK_ENABLED=false
CODM_REGION_CHECK_DEVICE_ID=7375628e-3842-4dad-be2a-50561c3eb657
CODM_REGION_CHECK_TIMEOUT=4
CODM_REGION_CHECK_CACHE_TTL=86400
CODM_REGION_CHECK_STORE_ORIGIN=https://store.callofdutymobile.com

# Smart Search — driver stays database until cutover. Do not put Meili keys in frontend env.
SMART_SEARCH_DRIVER=database
SMART_SEARCH_INDEX_PREFIX=charjino_local_
SMART_SEARCH_TIMEOUT_MS=1200
SMART_SEARCH_QUEUE=search
SMART_SEARCH_SCOUT_SYNC=false
SMART_SEARCH_INDEX_WRITES=false
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
SCOUT_DRIVER=null
SCOUT_QUEUE=true
SCOUT_QUEUE_NAME=search

TOROB_SHOP_BASE_URL=https://charjino.ir
TOROB_JWT_AUD=api.charjino.ir
TOROB_JWT_SKIP=false
# Split-by-SKU Torob feed. Default stays Rewarble USD (887). Do not enable groups without an explicit rollout.
TOROB_SPLIT_BY_SKU_ENABLED_PRODUCT_IDS=887
TOROB_SPLIT_BY_SKU_ENABLED_GROUP_SLUGS=
TOROB_SPLIT_BY_SKU_EXCLUDE_PRODUCT_IDS=
TOROB_SPLIT_BY_SKU_MAX_ITEMS_PER_PRODUCT=30
