+        if (preg_match('/^\d+(?:\.\d+)?$/', $raw) !== 1 || (float) $raw <= 0) {
+            return null;
+        }
+        $raw = ltrim($raw, '0');
+
+        return $raw === '' || $raw[0] === '.' ? '0'.$raw : $raw;
