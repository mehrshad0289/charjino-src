+    /**
+     * "80 + 8 CP" → "80 + 8"; "500 Diamonds" → "500". Anything else in the name (packs, passes,
+     * "(First Top-Up Bonus)") is not representable without a config mapping → not split.
+     */
+    private function topupAmountText(string $name, ?string $persianUnit = null): ?string
+    {
+        $unitAliases = array_keys($this->stringMap('unit_aliases'));
+        if ($persianUnit !== null && $persianUnit !== '') {
+            $unitAliases[] = $persianUnit;
+        }
+        usort($unitAliases, static fn (string $a, string $b): int => mb_strlen($b) <=> mb_strlen($a));
+        $units = implode('|', array_map(static fn (string $u): string => preg_quote($u, '/'), $unitAliases));
+        if ($units === '') {
+            return null;
+        }
+        if (preg_match('/^\s*(\d+)\s*\+\s*(\d+)\s*(?:'.$units.')\s*$/iu', $name, $m) === 1) {
+            return ((int) $m[1] > 0 && (int) $m[2] > 0) ? ((int) $m[1]).' + '.((int) $m[2]) : null;
+        }
+        if (preg_match('/^\s*(\d+)\s*(?:'.$units.')\s*$/iu', $name, $m) === 1) {
+            return (int) $m[1] > 0 ? (string) (int) $m[1] : null;
+        }
+
+        return null;
+    }
